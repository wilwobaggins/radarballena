# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini
LLM_ENABLE_FALLBACK=true

# Polymarket
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_LIMIT=100
POLYMARKET_MAX_PAGES=1

# DeepSignal selection
DEEPSIGNAL_TOP_N=5
DEEPSIGNAL_MAX_PER_CATEGORY=2
DEEPSIGNAL_MAX_PER_TOPIC=2
DEEPSIGNAL_MAX_PER_EVENT_FAMILY=2

# DeepSignal generation
DEEPSIGNAL_MAX_RETRIES=3
DEEPSIGNAL_MAX_OUTPUT_TOKENS=5000

# Daily pipeline
DAILY_PIPELINE_ATTEMPT_POOL=30

# Closing rechecks
CLOSING_RECHECK_ENABLED=false
CLOSING_RECHECK_INTERVAL_SECONDS=3600
CLOSING_RECHECK_MAX_PER_RUN=2
CLOSING_RECHECK_MAX_DAYS_TO_CLOSE=3
CLOSING_RECHECK_MIN_PRIORITY=HIGH
CLOSING_RECHECK_FRESHNESS_HOURS=12
CLOSING_RECHECK_REQUEST_TIMEOUT_SECONDS=30
CLOSING_RECHECK_MAX_RETRIES=2
CLOSING_RECHECK_MAX_PER_CATEGORY=2
CLOSING_RECHECK_COMMAND=python -m scripts.run_closing_rechecks --once

# Market filters
MIN_MARKET_VOLUME=1000
MIN_MARKET_LIQUIDITY=500

# Output
OUTPUT_DIR=output

# Backend / Supabase - próxima fase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACKEND_URL=https://app.radarballena.com

# Backend internal API - opcional
BACKEND_DEEPSIGNAL_ENDPOINT=
INTERNAL_API_KEY=

# Context sources - próxima fase
NEWS_API_KEY=
SERPAPI_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
